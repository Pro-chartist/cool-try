# GitHub Configuration
# Create a fine-grained token with access to this repository and permission to
# trigger repository_dispatch events/read workflow results. Do not commit a real token.
GITHUB_TOKEN=your_github_token_here

# Repository that contains .github/workflows/screener.yml, in owner/repo format.
NEXT_PUBLIC_GITHUB_REPO=Prochartist-cool/cool-try

# Note: NEXT_PUBLIC_ variables are visible to the browser in Next.js.
# GITHUB_TOKEN is read only by API routes and must stay server-side.
